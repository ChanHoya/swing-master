# Environment Variables — Swing Master Backend
# Copy this file to .env and fill in real values

# ── Application ──────────────────────────────────────────────────────────────
ENV=development
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_openssl_rand_hex_32

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/swingmaster

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=swing-master
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── CORS (comma-separated) ───────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]
