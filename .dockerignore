# 빌드 컨텍스트에서 뺄 것들.
#
# 없을 때 1.85GB 가 전송됐다. 대부분 .venv 와 node_modules 다.
# 이미지에 들어가지도 않으면서 빌드 시간만 잡아먹는다.

# 파이썬 가상환경 (이미지 안에서 새로 설치한다)
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/

# 프론트엔드 — 백엔드 이미지에 필요 없다
frontend/
NewUI/

# 개발 도구 상태
.git/
.serena/
.superpowers/
.claude/

# 문서
docs/
*.md

# 비밀값 — 환경변수로 주입한다. 이미지에 절대 넣지 않는다.
**/.env
**/.env.local

# OS·에디터
.DS_Store
.vscode/
.idea/

# 로컬 실행 흔적
*.pid
*.log
